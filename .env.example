# Copy to .env and fill in. .env is gitignored.
TATA_DATA=/srv/tata/data        # sqlite + generated PDFs, owned by TATA_UID
TATA_CERTS=/srv/tata/certs      # server.crt + server.key, kept fresh by the cert pusher
TATA_NETWORK=vlan53             # external macvlan network
TATA_IP=192.168.53.10           # the container's own LAN address
TATA_USER=change-me             # the employer's login name
TATA_PASSWORD=change-me         # the employer's login password
TATA_RIMBORSO_KM=               # optional, with the next: km per turno, andata e ritorno
TATA_RIMBORSO_EURO_KM=          # ACI table €/km of the worker's car, e.g. 0.4463
TATA_UID=1000                   # host user owning TATA_DATA and TATA_CERTS
TATA_GID=1000
# Optional wifi presence (/presenza): both or none. Each rapporto names its phone's tracker.
TATA_HA_URL=http://homeassistant.example:8123
TATA_HA_TOKEN=                  # Home Assistant long-lived access token
